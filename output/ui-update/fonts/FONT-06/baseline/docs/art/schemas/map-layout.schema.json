{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map composition contract",
  "type": "object",
  "required": [
    "master_size_px",
    "coordinate_origin",
    "camera",
    "display_transform",
    "zones",
    "layers",
    "hit_areas",
    "central_site_bounds_px"
  ],
  "properties": {
    "master_size_px": {
      "const": [
        1920,
        1080
      ]
    },
    "coordinate_origin": {
      "const": "top_left_y_down"
    },
    "camera": {
      "type": "object",
      "required": [
        "projection",
        "orientation_description",
        "light_direction_description"
      ]
    },
    "display_transform": {
      "type": "object",
      "required": [
        "uniform_scale",
        "offset_px",
        "target_viewport_px",
        "fit_mode"
      ],
      "properties": {
        "uniform_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offset_px": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "target_viewport_px": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4
        },
        "fit_mode": {
          "enum": [
            "contain",
            "cover"
          ]
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "catalog_id",
          "polygon_px",
          "label_anchor_px"
        ]
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "position_px",
          "scale",
          "order",
          "pivot"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "position_px": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "order": {
            "type": "integer"
          },
          "pivot": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "hit_areas": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "catalog_id",
          "polygon_px"
        ]
      }
    },
    "central_site_bounds_px": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    }
  }
}
