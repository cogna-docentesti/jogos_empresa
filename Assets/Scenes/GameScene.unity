  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Voc\xEA j\xE1 tem capital pr\xF3prio para come\xE7ar. Pode contratar um
    financiamento agora ou seguir sem empr\xE9stimo e voltar ao Banco durante o primeiro
    ou o segundo m\xEAs. No terceiro m\xEAs, novas contrata\xE7\xF5es n\xE3o s\xE3o
    permitidas.\n\nDepois de contratado, o financiamento n\xE3o pode ser trocado.
    Selecionar um cart\xE3o ainda n\xE3o contrata: revise os valores e confirme.\n\nValor
    dispon\xEDvel: quantia integral que ser\xE1 adicionada ao caixa ao contratar.\nJuros
    ao m\xEAs: percentual cobrado sobre o saldo devedor em cada m\xEAs.\nPrazo: meses
    restantes at\xE9 o fim do trimestre para pagar.\nParcela: parte do principal
    mais os juros sobre o saldo devedor; o valor diminui conforme a d\xEDvida \xE9
    paga.\nCapital inicial: seus recursos pr\xF3prios, sem incluir o empr\xE9stimo.\n\nVoc\xEA
    poder\xE1 acessar esta tela a qualquer momento pelo menu: Banco."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 89cea402e3db5bf4d9bc9d4f698b7692, type: 2}
  m_sharedMaterial: {fileID: 4744382643187915359, guid: 89cea402e3db5bf4d9bc9d4f698b7692, type: 2}
