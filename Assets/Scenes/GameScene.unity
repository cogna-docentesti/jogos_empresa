  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Esta \xE9 a tela de contrata\xE7\xE3o de funcion\xE1rios. Comece com a
    equipe m\xEDnima do seu restaurante, indicada nesta tela. Confirme a contrata\xE7\xE3o
    para concluir a prepara\xE7\xE3o.\n\nCada novo funcion\xE1rio aumenta a folha
    salarial mensal. Conforme a fun\xE7\xE3o, tamb\xE9m acrescenta capacidade de
    atendimento e contribui\xE7\xE3o de qualidade. A qualidade ajuda a reputa\xE7\xE3o
    quando o atendimento do m\xEAs \xE9 satisfat\xF3rio.\n\nMais capacidade n\xE3o
    garante mais vendas: o resultado depende da demanda, do espa\xE7o e dos equipamentos.
    O gerente contribui para a qualidade, mas n\xE3o acrescenta capacidade.\n\nDepois,
    no RH do menu, voc\xEA poder\xE1 contratar mais funcion\xE1rios. Os cart\xF5es
    mostram o custo mensal e os efeitos de cada contrata\xE7\xE3o.\n\nVoc\xEA poder\xE1
    acessar esta tela a qualquer momento pelo menu: Ag\xEAncia de RH."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 89cea402e3db5bf4d9bc9d4f698b7692, type: 2}
  m_sharedMaterial: {fileID: 4744382643187915359, guid: 89cea402e3db5bf4d9bc9d4f698b7692, type: 2}
