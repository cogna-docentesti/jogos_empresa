# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ir para o Git (ele já está no .gitignore).

# Porta HTTP. Em serviços como o Render, a porta é definida automaticamente.
PORT=3000

# Login do painel (autenticação básica do navegador).
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Onde os dados são gravados:
#   file   -> arquivos JSON na pasta DATA_DIR (uso local)
#   github -> arquivos JSON dentro de um repositório GitHub (uso no servidor gratuito)
STORAGE=file

# Usado quando STORAGE=file. Padrão: pasta "admin-data" na raiz do projeto Unity.
# DATA_DIR=../admin-data

# Usados quando STORAGE=github
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx
# GITHUB_REPO=cogna-docentesti/jogos_empresa
# GITHUB_BRANCH=main
# GITHUB_DATA_DIR=admin-data
